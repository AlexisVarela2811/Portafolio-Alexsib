---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import LinkedInIcon from "../components/icon/Linkedln.astro";
import GitHubIcon from "../components/icon/GitHub.astro";
import MailIcon from "../components/icon/Mail.astro";
import Social from "../components/Social.astro";
import Experience from "../components/Experience.astro";
import SectionConteiner from "../components/SectionConteiner.astro";
import BriefCase from "../components/icon/BriefCase.astro";
import CodeIcon from "../components/icon/Code.astro";
import Projects from "../components/Projects.astro";
---

<Layout
  title="Alexis Varela Muñoz | Desarrollador de Software | Backend Python y Full Stack"
  description="Analista Programador Computacional titulado. Desarrollo backend y Full Stack con Python, Django, FastAPI y React. Automatización de procesos en Signum-BI y creador de NexusGym."
>
  <main class="px-4">
    <SectionConteiner id="sobre-mi" class="py-32 pb-32">
      <img
        class="rounded-full size-12 mb-4"
        src="/Alexis.webp"
        alt="Alexis Varela Muñoz"
      />
      <h1
        class="text-ink text-3xl md:text-4xl lg:text-5xl font-bold pb-4"
      >
        Alexis Varela Muñoz <span class="waving-hand">👋</span>
      </h1>
      <h2 class="text-accent text-xl lg:text-2xl font-semibold mb-6">
        Desarrollador de Software | Backend Python y Full Stack
      </h2>
      <Badge>Analista Programador Computacional · Duoc UC · Titulado</Badge>
      <div class="text-ink text-lg lg:text-xl max-w-[700px] text-pretty mt-6 space-y-4">
        <p>
          Desarrollo aplicaciones backend y Full Stack, principalmente con
          <span class="text-accent">Python, Django, FastAPI y React</span>.
          En Signum-BI automaticé conciliaciones bancarias y la extracción de datos
          de documentos.
        </p>
        <p>
          También desarrollé desde cero y vendí
          <span class="text-accent">NexusGym</span>, un sistema de gestión que
          hoy sigue usando un gimnasio y que tiene alrededor de 160 socios registrados.
        </p>
      </div>
      <nav class="flex gap-4 mt-8 flex-wrap">
        <Social href="https://linkedin.com/in/alexisfabianvarela">
          <LinkedInIcon class="size-4 md:size-6" />
          LinkedIn
        </Social>
        <Social href="https://github.com/AlexisVarela2811">
          <GitHubIcon class="size-4 md:size-6" />
          GitHub
        </Social>
        <Social href="mailto:alexisfabian1230@gmail.com">
          <MailIcon class="size-4 md:size-6" />
          alexisfabian1230@gmail.com
        </Social>
        <Social href="tel:+56961505796">
          +56 9 6150 5796
        </Social>
      </nav>
    </SectionConteiner>

    <SectionConteiner id="experiencia">
      <h2 class="text-ink text-3xl font-semibold mb-6 flex gap-x-3 items-center">
        <BriefCase class="size-7" />
        Experiencia Laboral
      </h2>
      <Experience />
    </SectionConteiner>

    <SectionConteiner id="proyectos">
      <h2 class="text-ink text-3xl font-semibold mb-6 flex gap-x-3 items-center">
        <CodeIcon class="size-7" />
        Proyectos
      </h2>
      <Projects />
    </SectionConteiner>
  </main>
</Layout>
