---
import Row from "./icon/Row.astro";
export interface Props {
    title: string;
    description: string;
    link?: string;
    date: string;
  }

const {title, description, link, date} = Astro.props
---
<time
      class="mb-1 text-sm font-normal leading-none text-muted"
      >{date}</time
    >
    <h3 class="text-lg font-semibold text-accent mt-4">
      {title}
    </h3>
    <p class="mb-4 text-base font-normal text-ink text-pretty whitespace-pre-line">
      {description}
    </p>

{
  link && (
    
  <a  
      rel="noopener noreferrer"
      target="_blank"
      href={link}
      class="inline-flex items-center px-4 py-2 text-sm font-medium text-ink bg-surface border border-line rounded-lg hover:text-accent hover:border-accent transition-colors"
      >Saber mas...{" "}  
      <Row class="w-3 h-3 ms-2" />
    </a>
  )
}
