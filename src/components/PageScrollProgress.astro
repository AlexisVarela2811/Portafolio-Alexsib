<page-scroll-progress aria-hidden="true">
  <span data-page-progress></span>
</page-scroll-progress>

<script>
  class PageScrollProgress extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const events = new AbortController();
      let frame = 0;
      const render = () => {
        frame = 0;
        const range = document.documentElement.scrollHeight - window.innerHeight;
        const progress = range > 0 ? Math.min(1, Math.max(0, window.scrollY / range)) : 0;
        this.style.setProperty('--page-progress', String(progress));
      };
      const schedule = () => {
        if (!frame) frame = window.requestAnimationFrame(render);
      };
      window.addEventListener('scroll', schedule, { passive: true, signal: events.signal });
      window.addEventListener('resize', schedule, { signal: events.signal });
      window.addEventListener('pageshow', schedule, { signal: events.signal });
      window.addEventListener('load', schedule, { signal: events.signal });
      const observer = new ResizeObserver(schedule);
      observer.observe(document.documentElement);
      observer.observe(document.body);
      document.fonts.ready.then(() => {
        if (this.isConnected) schedule();
      });
      render();
      this.cleanup = () => {
        events.abort();
        observer.disconnect();
        window.cancelAnimationFrame(frame);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('page-scroll-progress')) {
    customElements.define('page-scroll-progress', PageScrollProgress);
  }
</script>

<style>
  page-scroll-progress {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: block;
    height: 2px;
    pointer-events: none;
    background: var(--matrix-border);
  }

  [data-page-progress] {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(var(--page-progress, 0));
    transform-origin: left;
    background: linear-gradient(to right, var(--matrix-accent), var(--matrix-bright));
    filter: drop-shadow(0 0 4px var(--matrix-glow));
  }
</style>
