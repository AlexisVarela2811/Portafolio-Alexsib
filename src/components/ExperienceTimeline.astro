<experience-timeline class="experience-timeline">
  <div class="timeline-track" aria-hidden="true">
    <div class="timeline-progress" data-timeline-progress></div>
  </div>
  <ol class="timeline-entries" role="list">
    <slot />
  </ol>
</experience-timeline>

<script>
  class ExperienceTimeline extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const markers = Array.from(
        this.querySelectorAll<HTMLElement>('[data-timeline-marker]'),
      );
      if (!markers.length) return;

      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const events = new AbortController();
      let frame = 0;

      const render = () => {
        frame = 0;
        const rootTop = this.getBoundingClientRect().top;
        const centers = markers.map((marker) => {
          const rect = marker.getBoundingClientRect();
          return rect.top + rect.height / 2;
        });
        const first = centers[0];
        const last = centers[centers.length - 1];
        // The reading position activates a milestone before it reaches mid-screen.
        const readingPosition = window.innerHeight * 0.65;
        const progress = motion.matches
          ? 1
          : last === first
            ? Number(readingPosition >= first)
            : Math.min(1, Math.max(0, (readingPosition - first) / (last - first)));

        this.style.setProperty('--timeline-top', `${first - rootTop}px`);
        this.style.setProperty('--timeline-height', `${last - first}px`);
        this.style.setProperty('--timeline-progress', String(progress));
        markers.forEach((marker, index) => {
          marker.dataset.active = String(motion.matches || centers[index] <= readingPosition);
        });
      };

      const schedule = () => {
        if (!frame) frame = window.requestAnimationFrame(render);
      };

      window.addEventListener('scroll', schedule, { passive: true, signal: events.signal });
      window.addEventListener('resize', schedule, { signal: events.signal });
      motion.addEventListener('change', schedule, { signal: events.signal });
      const observer = new ResizeObserver(schedule);
      observer.observe(this);
      // Font loading can move the section without changing its own dimensions.
      document.fonts.ready.then(() => {
        if (this.isConnected) schedule();
      });
      render();

      this.cleanup = () => {
        events.abort();
        observer.disconnect();
        window.cancelAnimationFrame(frame);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('experience-timeline')) {
    customElements.define('experience-timeline', ExperienceTimeline);
  }
</script>

<style>
  .experience-timeline {
    /* A complete static timeline is the baseline without JavaScript. */
    --timeline-progress: 1;
    display: block;
    position: relative;
    margin-inline: 0.625rem 0.25rem;
  }

  .timeline-track {
    position: absolute;
    top: var(--timeline-top, 0.8125rem);
    left: 0;
    width: 2px;
    height: var(--timeline-height, calc(100% - 0.8125rem));
    background: var(--matrix-border);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .timeline-progress {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, var(--matrix-bright), var(--matrix-accent));
    transform: scaleY(var(--timeline-progress));
    transform-origin: top;
    filter: drop-shadow(0 0 4px var(--matrix-glow));
  }

  .timeline-entries {
    list-style: none;
    margin: 0;
    padding: 0 0 0 2rem;
  }

  .experience-timeline :global(.timeline-entry) {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .experience-timeline :global(.timeline-entry:last-child) {
    padding-bottom: 0;
  }

  .experience-timeline :global(.timeline-marker) {
    position: absolute;
    left: -2rem;
    top: 0.375rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    border: 2px solid var(--matrix-border);
    background: var(--matrix-surface);
    box-shadow: 0 0 0 5px var(--matrix-canvas);
    transform: translateX(-50%);
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .experience-timeline :global(.timeline-marker[data-active='true']) {
    border-color: var(--matrix-bright);
    background: var(--matrix-accent);
    box-shadow: 0 0 0 6px var(--matrix-glow), 0 0 18px var(--matrix-glow);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-progress {
      transform: none;
    }

    .experience-timeline :global(.timeline-marker) {
      transition: none;
    }
  }
</style>
